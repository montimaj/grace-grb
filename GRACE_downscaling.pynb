      "source": [
        "# install and initialize GEE\n",
        "!pip install earthengine-api\n",
        "import ee\n",
        "ee.Authenticate()\n",
        "ee.Initialize(\n",
        "    project='grace-grb',\n",
        "    opt_url='https://earthengine-highvolume.googleapis.com'\n",
        ")"
      ]
    },
