      "source": [
        "# Import necessary libraries\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import calendar\n",
        "\n",
        "# ML specific\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "import xgboost as xgb # For XGBoost\n",
        "\n",
        "# DL specific\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import LSTM, Dense, Dropout\n",
        "\n",
        "# --- 1. Synthetic Data Generation ---\n",
        "# We'll generate daily data first, then aggregate it to monthly to have a consistent dataset.\n",
        "\n",
        "# Configuration\n",
        "np.random.seed(42) # for reproducibility\n",
        "tf.random.set_seed(42) # for reproducibility in TensorFlow\n",
        "start_year = 2010\n",
        "end_year = 2014 # Extended to have more data for DL and robust splitting\n",
        "n_years = end_year - start_year + 1\n",
        "\n",
        "# Generate daily dates\n",
        "date_rng_daily = pd.date_range(start=f'{start_year}-01-01', end=f'{end_year}-12-31', freq='D')\n",
        "n_days = len(date_rng_daily)\n",
        "\n",
        "# Create synthetic daily TWSA\n",
        "# Simulate a base trend, seasonality, and some daily noise\n",
        "time_daily = np.arange(n_days)\n",
        "# Base trend (slowly decreasing)\n",
        "trend_daily = -0.05 * (time_daily / 365)\n",
        "# Seasonal component (sine wave for annual cycle)\n",
        "seasonality_daily = 2.5 * np.sin(2 * np.pi * time_daily / 365.25) + \\\n",
        "                    1.0 * np.sin(2 * np.pi * time_daily / (365.25 / 2)) # Semi-annual\n",
        "# Daily noise\n",
        "noise_daily = 0.5 * np.random.randn(n_days)\n",
        "# Short-term variations (e.g., response to hypothetical rain events)\n",
        "short_term_events = np.zeros(n_days)\n",
        "for _ in range(n_years * 5): # Add 5 \"events\" per year\n",
        "    event_start = np.random.randint(0, n_days - 30)\n",
        "    event_duration = np.random.randint(5, 15)\n",
        "    event_magnitude = np.random.uniform(0.5, 2.0) * (1 if np.random.rand() > 0.3 else -1) # Can be positive or negative\n",
        "    event_effect = event_magnitude * np.exp(-np.arange(event_duration)/5)\n",
        "    short_term_events[event_start : event_start + event_duration] += event_effect\n",
        "\n",
        "synthetic_daily_twsa = 10 + trend_daily + seasonality_daily + noise_daily + short_term_events\n",
        "daily_data = pd.DataFrame({'date': date_rng_daily, 'daily_twsa_true': synthetic_daily_twsa})\n",
        "daily_data.set_index('date', inplace=True)\n",
        "\n",
        "# Aggregate daily data to monthly data\n",
        "# This will be our \"GRACE-like\" monthly input\n",
        "monthly_data = daily_data['daily_twsa_true'].resample('MS').mean().to_frame() # 'MS' for month start\n",
        "monthly_data.rename(columns={'daily_twsa_true': 'monthly_twsa_grace'}, inplace=True)\n",
        "monthly_data['year'] = monthly_data.index.year\n",
        "monthly_data['month'] = monthly_data.index.month\n",
        "\n",
        "print(\"--- Synthetic Monthly TWSA (Input) ---\")\n",
        "print(monthly_data.head())\n",
        "print(\"\\n--- Synthetic Daily TWSA (Target for training/evaluation) ---\")\n",
        "print(daily_data.head())\n",
        "\n",
        "# Plot synthetic data\n",
        "plt.figure(figsize=(15, 6))\n",
        "plt.plot(daily_data.index, daily_data['daily_twsa_true'], label='True Daily TWSA (Synthetic)', alpha=0.7)\n",
        "monthly_data['monthly_twsa_grace'].plot(label='Monthly Aggregated TWSA (Synthetic GRACE)', marker='o', linestyle='--')\n",
        "plt.title('Synthetic TWSA Data')\n",
        "plt.xlabel('Date')\n",
        "plt.ylabel('TWSA (cm)')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "# plt.show() # Show all plots at the end or as needed\n",
        "\n",
        "# --- 2. Feature Engineering for Daily Data (Mainly for RF and XGBoost) ---\n",
        "daily_data_ml = daily_data.copy()\n",
        "daily_data_ml['year'] = daily_data_ml.index.year\n",
        "daily_data_ml['month'] = daily_data_ml.index.month\n",
        "\n",
        "monthly_data['year_month'] = monthly_data['year'].astype(str) + '_' + monthly_data['month'].astype(str)\n",
        "daily_data_ml['year_month'] = daily_data_ml['year'].astype(str) + '_' + daily_data_ml['month'].astype(str)\n",
        "\n",
        "daily_data_ml = pd.merge(daily_data_ml.reset_index(),\n",
        "                         monthly_data[['monthly_twsa_grace', 'year_month']],\n",
        "                         on='year_month',\n",
        "                         how='left').set_index('date')\n",
        "\n",
        "daily_data_ml['day_of_year'] = daily_data_ml.index.dayofyear\n",
        "daily_data_ml['day_of_month'] = daily_data_ml.index.day\n",
        "daily_data_ml['week_of_year'] = daily_data_ml.index.isocalendar().week.astype(int)\n",
        "daily_data_ml['quarter'] = daily_data_ml.index.quarter\n",
        "\n",
        "days_in_year = np.array([calendar.isleap(y) for y in daily_data_ml['year']]) * 1 + 365\n",
        "daily_data_ml['day_of_year_sin'] = np.sin(2 * np.pi * daily_data_ml['day_of_year'] / days_in_year)\n",
        "daily_data_ml['day_of_year_cos'] = np.cos(2 * np.pi * daily_data_ml['day_of_year'] / days_in_year)\n",
        "daily_data_ml['month_sin'] = np.sin(2 * np.pi * daily_data_ml['month'] / 12)\n",
        "daily_data_ml['month_cos'] = np.cos(2 * np.pi * daily_data_ml['month'] / 12)\n",
        "\n",
        "monthly_data_interpolated = monthly_data['monthly_twsa_grace'].resample('D').interpolate(method='linear')\n",
        "daily_data_ml = daily_data_ml.join(monthly_data_interpolated.rename('monthly_twsa_interpolated'))\n",
        "daily_data_ml.dropna(inplace=True)\n",
        "\n",
        "print(\"\\n--- Features for ML Models (RF, XGBoost) ---\")\n",
        "print(daily_data_ml.head())\n",
        "\n",
        "# --- 3. Data Splitting for RF and XGBoost ---\n",
        "features_ml = [\n",
        "    'monthly_twsa_grace', 'monthly_twsa_interpolated',\n",
        "    'day_of_year_sin', 'day_of_year_cos',\n",
        "    'month_sin', 'month_cos',\n",
        "    'year', 'day_of_month', 'week_of_year', 'quarter'\n",
        "]\n",
        "X_ml = daily_data_ml[features_ml]\n",
        "y_ml = daily_data_ml['daily_twsa_true']\n",
        "\n",
        "# Chronological split: Train on first N-1 years, test on the last year\n",
        "train_end_date_ml = f'{end_year-1}-12-31'\n",
        "X_train_ml = X_ml[X_ml.index <= train_end_date_ml]\n",
        "y_train_ml = y_ml[y_ml.index <= train_end_date_ml]\n",
        "X_test_ml = X_ml[X_ml.index > train_end_date_ml]\n",
        "y_test_ml = y_ml[y_ml.index > train_end_date_ml]\n",
        "\n",
        "if X_test_ml.empty:\n",
        "    print(\"ML Test set is empty, adjusting split for demonstration (using random split). NOT IDEAL FOR TIME SERIES.\")\n",
        "    X_train_ml, X_test_ml, y_train_ml, y_test_ml = train_test_split(X_ml, y_ml, test_size=0.25, random_state=42, shuffle=False)\n",
        "\n",
        "print(f\"\\nML Training data shape: {X_train_ml.shape}, {y_train_ml.shape}\")\n",
        "print(f\"ML Testing data shape: {X_test_ml.shape}, {y_test_ml.shape}\")\n",
        "\n",
        "# --- 4. Random Forest Model ---\n",
        "print(\"\\n--- Training Random Forest Model ---\")\n",
        "rf_model = RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1, max_depth=15, min_samples_split=5)\n",
        "rf_model.fit(X_train_ml, y_train_ml)\n",
        "y_pred_rf = rf_model.predict(X_test_ml)\n",
        "\n",
        "mse_rf = mean_squared_error(y_test_ml, y_pred_rf)\n",
        "rmse_rf = np.sqrt(mse_rf)\n",
        "r2_rf = r2_score(y_test_ml, y_pred_rf)\n",
        "print(f\"Random Forest - MSE: {mse_rf:.4f}, RMSE: {rmse_rf:.4f}, R²: {r2_rf:.4f}\")\n",
        "\n",
        "# --- 5. XGBoost Model ---\n",
        "print(\"\\n--- Training XGBoost Model ---\")\n",
        "xgb_model = xgb.XGBRegressor(objective='reg:squarederror', n_estimators=100, random_state=42,\n",
        "                             learning_rate=0.1, max_depth=7, subsample=0.8, colsample_bytree=0.8)\n",
        "xgb_model.fit(X_train_ml, y_train_ml)\n",
        "y_pred_xgb = xgb_model.predict(X_test_ml)\n",
        "\n",
        "mse_xgb = mean_squared_error(y_test_ml, y_pred_xgb)\n",
        "rmse_xgb = np.sqrt(mse_xgb)\n",
        "r2_xgb = r2_score(y_test_ml, y_pred_xgb)\n",
        "print(f\"XGBoost - MSE: {mse_xgb:.4f}, RMSE: {rmse_xgb:.4f}, R²: {r2_xgb:.4f}\")\n",
        "\n",
        "\n",
        "# --- 6. LSTM Model ---\n",
        "print(\"\\n--- Preparing Data for LSTM Model ---\")\n",
        "# Features for LSTM: monthly value, and cyclical daily/monthly patterns.\n",
        "# We can also include the true daily TWSA for creating sequences if we model it autoregressively,\n",
        "# or just use external regressors. Here, we use external regressors and predict daily TWSA directly.\n",
        "features_lstm_cols = ['monthly_twsa_grace', 'day_of_year_sin', 'day_of_year_cos', 'month_sin', 'month_cos']\n",
        "target_lstm_col = 'daily_twsa_true'\n",
        "\n",
        "data_for_lstm = daily_data_ml[features_lstm_cols + [target_lstm_col]].copy()\n",
        "data_for_lstm.dropna(inplace=True)\n",
        "\n",
        "# Scale features for LSTM\n",
        "scaler_features_lstm = MinMaxScaler(feature_range=(0, 1))\n",
        "scaled_features_lstm = scaler_features_lstm.fit_transform(data_for_lstm[features_lstm_cols])\n",
        "\n",
        "scaler_target_lstm = MinMaxScaler(feature_range=(0, 1))\n",
        "scaled_target_lstm = scaler_target_lstm.fit_transform(data_for_lstm[[target_lstm_col]])\n",
        "\n",
        "scaled_data_lstm = np.concatenate((scaled_features_lstm, scaled_target_lstm), axis=1)\n",
        "\n",
        "# Create sequences\n",
        "def create_sequences(data, features_data, target_data, sequence_length):\n",
        "    X_seq, y_seq, seq_dates = [], [], []\n",
        "    original_indices = data.index\n",
        "    for i in range(len(data) - sequence_length):\n",
        "        X_seq.append(features_data[i:(i + sequence_length)])\n",
        "        y_seq.append(target_data[i + sequence_length])\n",
        "        seq_dates.append(original_indices[i + sequence_length]) # Date for the y value\n",
        "    return np.array(X_seq), np.array(y_seq), pd.to_datetime(seq_dates)\n",
        "\n",
        "sequence_length = 30 # Use last 30 days of features\n",
        "X_seq, y_seq, seq_dates_all = create_sequences(data_for_lstm, scaled_features_lstm, scaled_target_lstm.flatten(), sequence_length)\n",
        "\n",
        "print(f\"Shape of X_seq: {X_seq.shape}\")\n",
        "print(f\"Shape of y_seq: {y_seq.shape}\")\n",
        "print(f\"Number of sequence dates: {len(seq_dates_all)}\")\n",
        "\n",
        "\n",
        "# Chronological split for LSTM data\n",
        "# Find the index for splitting based on date\n",
        "# The test period for LSTM will be the same as for ML models (last year)\n",
        "# Ensure seq_dates_all are used to correctly align with X_test_ml.index.min()\n",
        "split_date_lstm = X_test_ml.index.min()\n",
        "train_mask = seq_dates_all < split_date_lstm\n",
        "test_mask = seq_dates_all >= split_date_lstm\n",
        "\n",
        "X_train_lstm, X_test_lstm = X_seq[train_mask], X_seq[test_mask]\n",
        "y_train_lstm, y_test_lstm = y_seq[train_mask], y_seq[test_mask]\n",
        "dates_test_lstm = seq_dates_all[test_mask]\n",
        "\n",
        "\n",
        "# If X_test_lstm is empty (e.g. if sequence_length pushes all data past the split)\n",
        "# this can happen if end_year is too small.\n",
        "if X_test_lstm.shape[0] == 0:\n",
        "    print(\"LSTM Test set is empty due to sequence length and split date. Adjusting to a simple percentage split. NOT IDEAL.\")\n",
        "    train_size_lstm = int(len(X_seq) * 0.8)\n",
        "    X_train_lstm, X_test_lstm = X_seq[:train_size_lstm], X_seq[train_size_lstm:]\n",
        "    y_train_lstm, y_test_lstm = y_seq[:train_size_lstm], y_seq[train_size_lstm:]\n",
        "    dates_test_lstm = seq_dates_all[train_size_lstm:]\n",
        "\n",
        "\n",
        "print(f\"LSTM Training data shape: {X_train_lstm.shape}, {y_train_lstm.shape}\")\n",
        "print(f\"LSTM Testing data shape: {X_test_lstm.shape}, {y_test_lstm.shape}\")\n",
        "print(f\"LSTM Test dates length: {len(dates_test_lstm)}\")\n",
        "\n",
        "\n",
        "# Define LSTM model\n",
        "lstm_model = Sequential([\n",
        "    LSTM(units=64, activation='relu', input_shape=(X_train_lstm.shape[1], X_train_lstm.shape[2]), return_sequences=True),\n",
        "    Dropout(0.2),\n",
        "    LSTM(units=32, activation='relu', return_sequences=False),\n",
        "    Dropout(0.2),\n",
        "    Dense(units=16, activation='relu'),\n",
        "    Dense(units=1)\n",
        "])\n",
        "lstm_model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.001), loss='mean_squared_error')\n",
        "lstm_model.summary()\n",
        "\n",
        "print(\"\\n--- Training LSTM Model ---\")\n",
        "history_lstm = lstm_model.fit(\n",
        "    X_train_lstm, y_train_lstm,\n",
        "    epochs=50, # Reduce for quicker run, increase for potentially better performance\n",
        "    batch_size=32,\n",
        "    validation_split=0.1,\n",
        "    shuffle=False,\n",
        "    verbose=1,\n",
        "    callbacks=[tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=5, restore_best_weights=True)]\n",
        ")\n",
        "\n",
        "# Plot LSTM training history\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(history_lstm.history['loss'], label='Training Loss')\n",
        "plt.plot(history_lstm.history['val_loss'], label='Validation Loss')\n",
        "plt.title('LSTM Model Training and Validation Loss')\n",
        "plt.xlabel('Epoch')\n",
        "plt.ylabel('Loss (MSE)')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "# plt.show()\n",
        "\n",
        "# LSTM Prediction and Evaluation\n",
        "y_pred_scaled_lstm = lstm_model.predict(X_test_lstm)\n",
        "y_pred_lstm = scaler_target_lstm.inverse_transform(y_pred_scaled_lstm)\n",
        "y_test_actual_lstm = scaler_target_lstm.inverse_transform(y_test_lstm.reshape(-1, 1))\n",
        "\n",
        "# Align y_test_actual_lstm and y_pred_lstm with dates_test_lstm for DataFrame creation\n",
        "y_test_actual_lstm_flat = y_test_actual_lstm.flatten()\n",
        "y_pred_lstm_flat = y_pred_lstm.flatten()\n",
        "\n",
        "min_len_lstm = min(len(dates_test_lstm), len(y_test_actual_lstm_flat), len(y_pred_lstm_flat))\n",
        "\n",
        "results_df_lstm = pd.DataFrame({\n",
        "    'true_daily_twsa': y_test_actual_lstm_flat[:min_len_lstm],\n",
        "    'predicted_daily_twsa_lstm': y_pred_lstm_flat[:min_len_lstm]\n",
        "}, index=dates_test_lstm[:min_len_lstm])\n",
        "\n",
        "\n",
        "mse_lstm = mean_squared_error(results_df_lstm['true_daily_twsa'], results_df_lstm['predicted_daily_twsa_lstm'])\n",
        "rmse_lstm = np.sqrt(mse_lstm)\n",
        "r2_lstm = r2_score(results_df_lstm['true_daily_twsa'], results_df_lstm['predicted_daily_twsa_lstm'])\n",
        "print(f\"LSTM - MSE: {mse_lstm:.4f}, RMSE: {rmse_lstm:.4f}, R²: {r2_lstm:.4f}\")\n",
        "\n",
        "\n",
        "# --- 7. Visualization of All Results ---\n",
        "results_df_ml = pd.DataFrame({\n",
        "    'date': y_test_ml.index,\n",
        "    'true_daily_twsa': y_test_ml,\n",
        "    'predicted_rf': y_pred_rf,\n",
        "    'predicted_xgb': y_pred_xgb\n",
        "}).set_index('date')\n",
        "\n",
        "plt.figure(figsize=(18, 9))\n",
        "results_df_ml['true_daily_twsa'].plot(label='True Daily TWSA (Test Set)', alpha=0.7)\n",
        "results_df_ml['predicted_rf'].plot(label='Predicted (Random Forest)', linestyle='--', alpha=0.8)\n",
        "results_df_ml['predicted_xgb'].plot(label='Predicted (XGBoost)', linestyle=':', alpha=0.8)\n",
        "\n",
        "# Plot LSTM results if they exist and align; they might be on a slightly different subset of test dates due to sequence_length\n",
        "if not results_df_lstm.empty:\n",
        "    results_df_lstm['predicted_daily_twsa_lstm'].plot(label='Predicted (LSTM)', linestyle='-.', alpha=0.8)\n",
        "\n",
        "# Plot the original monthly GRACE data for context on the test period\n",
        "monthly_data_test_period = monthly_data[monthly_data.index.year == y_test_ml.index.year.min()]\n",
        "if not monthly_data_test_period.empty:\n",
        "    monthly_data_test_period['monthly_twsa_grace'].plot(label='Monthly GRACE TWSA (Input)', marker='o', linestyle='-', color='gray', alpha=0.5)\n",
        "\n",
        "plt.title(f'Daily TWSA Downscaling Comparison (Test Year: {y_test_ml.index.year.min()})')\n",
        "plt.xlabel('Date')\n",
        "plt.ylabel('TWSA (cm)')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "# plt.show()\n",
        "\n",
        "# --- 8. Feature Importance ---\n",
        "# Random Forest\n",
        "importances_rf = rf_model.feature_importances_\n",
        "feature_importance_rf_df = pd.DataFrame({'feature': features_ml, 'importance': importances_rf})\n",
        "feature_importance_rf_df = feature_importance_rf_df.sort_values(by='importance', ascending=False)\n",
        "\n",
        "plt.figure(figsize=(12, 7))\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.barh(feature_importance_rf_df['feature'], feature_importance_rf_df['importance'])\n",
        "plt.xlabel('Importance')\n",
        "plt.ylabel('Feature')\n",
        "plt.title('RF Feature Importance')\n",
        "plt.gca().invert_yaxis()\n",
        "\n",
        "# XGBoost\n",
        "importances_xgb = xgb_model.feature_importances_\n",
        "feature_importance_xgb_df = pd.DataFrame({'feature': features_ml, 'importance': importances_xgb})\n",
        "feature_importance_xgb_df = feature_importance_xgb_df.sort_values(by='importance', ascending=False)\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.barh(feature_importance_xgb_df['feature'], feature_importance_xgb_df['importance'])\n",
        "plt.xlabel('Importance')\n",
        "plt.title('XGBoost Feature Importance')\n",
        "plt.gca().invert_yaxis()\n",
        "\n",
        "plt.tight_layout()\n",
        "# plt.show() # Display all plots at the end\n",
        "\n",
        "# Display all plots\n",
        "plt.show()\n",
        "\n",
        "\n",
        "print(\"\\n--- Summary of Model Performance (Test Set) ---\")\n",
        "print(f\"Random Forest - RMSE: {rmse_rf:.4f}, R²: {r2_rf:.4f}\")\n",
        "print(f\"XGBoost       - RMSE: {rmse_xgb:.4f}, R²: {r2_xgb:.4f}\")\n",
        "if not results_df_lstm.empty:\n",
        "    print(f\"LSTM          - RMSE: {rmse_lstm:.4f}, R²: {r2_lstm:.4f}\")\n",
        "else:\n",
        "    print(\"LSTM results are not available for summary (test set might have been empty).\")\n",
        "\n",
        "\n",
        "print(\"\\n--- Notes ---\")\n",
        "print(\"1. This notebook uses synthetic data. Real-world applications require actual GRACE data and relevant daily predictors (precipitation, temperature, etc.).\")\n",
        "print(\"2. Feature engineering is crucial. The current features are time-based. External physical drivers would significantly improve model performance.\")\n",
        "print(\"3. Chronological splitting for train/test is vital for time series to avoid data leakage.\")\n",
        "print(\"4. Hyperparameter tuning (e.g., GridSearchCV, KerasTuner) can optimize each model further.\")\n",
        "print(\"5. LSTM requires careful data preparation (scaling, sequencing). The test set for LSTM might be slightly smaller than for RF/XGBoost due to sequence creation if not handled carefully for alignment.\")\n",
        "print(\"6. Increased `end_year` for more data, especially beneficial for the LSTM model and robust train/test splits.\")"
      ]
    }
  ],
