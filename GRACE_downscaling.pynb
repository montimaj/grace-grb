            "\u001b[0;32m/usr/local/lib/python3.11/dist-packages/ee/data.py\u001b[0m in \u001b[0;36mgetTableDownloadId\u001b[0;34m(params)\u001b[0m\n\u001b[1;32m   1440\u001b[0m   }\n\u001b[1;32m   1441\u001b[0m   \u001b[0m_maybe_populate_workload_tag\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mqueryParams\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1442\u001b[0;31m   result = _execute_cloud_call(\n\u001b[0m\u001b[1;32m   1443\u001b[0m       \u001b[0m_get_cloud_projects\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1444\u001b[0m       \u001b[0;34m.\u001b[0m\u001b[0mtables\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n",
            "\u001b[0;32m/usr/local/lib/python3.11/dist-packages/ee/data.py\u001b[0m in \u001b[0;36m_execute_cloud_call\u001b[0;34m(call, num_retries)\u001b[0m\n\u001b[1;32m    408\u001b[0m     \u001b[0;32mreturn\u001b[0m \u001b[0mcall\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mexecute\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mnum_retries\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0mnum_retries\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    409\u001b[0m   \u001b[0;32mexcept\u001b[0m \u001b[0mgoogleapiclient\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0merrors\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mHttpError\u001b[0m \u001b[0;32mas\u001b[0m \u001b[0me\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 410\u001b[0;31m     \u001b[0;32mraise\u001b[0m \u001b[0m_translate_cloud_exception\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0me\u001b[0m\u001b[0;34m)\u001b[0m  \u001b[0;31m# pylint: disable=raise-missing-from\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    411\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    412\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n",
            "\u001b[0;31mEEException\u001b[0m: DateRange: Bad date/time '2002-13-01'."
          ]
        }
      ],
      "source": [
        "# make feature collection\n",
        "import json\n",
        "import pandas as pd\n",
        "import os\n",
        "import calendar\n",
        "\n",
        "year_list = range(2002, 2025)\n",
        "gdf = ganga_basin_gdf.to_crs(\"EPSG:4326\")\n",
        "geo_json = gdf.to_json()\n",
        "fc = ee.FeatureCollection(json.loads(geo_json))\n",
        "temp_dir = f'{workplace_dir}temp/'\n",
        "os.makedirs(temp_dir, exist_ok=True)\n",
        "\n",
        "# download daily GEE data\n",
        "\n",
        "grace_ic = ee.ImageCollection('NASA/GRACE/MASS_GRIDS_V04/MASCON_CRI')\n",
        "era5land_ic = ee.ImageCollection('ECMWF/ERA5_LAND/DAILY_AGGR')\n",
        "gldas_ic = ee.ImageCollection('NASA/GLDAS/V022/CLSM/G025/DA1D')\n",
        "\n",
        "date_list = []\n",
        "month_yr_list = []\n",
        "for year in year_list:\n",
        "    for month in range(1, 13):\n",
        "        month_yr = f'{year}-{month:02d}'\n",
        "        month_yr_list.append(month_yr)\n",
        "        max_day = calendar.monthrange(year, month)[1]\n",
        "        for day in range(1, max_day + 1):\n",
        "            date_str = f'{year}-{month:02d}-{day:02d}'\n",
        "            date_list.append(date_str)\n",
        "\n",
        "data_band_names = [\n",
        "    'rzsm_gldas_mm',\n",
        "    'ssm_gldas_mm',\n",
        "    'et_gldas_mm'\n",
        "    'tws_gldas_mm',\n",
        "    'ppt_era5_mm',\n",
        "    'runoff_era5_mm',\n",
        "    'tmax_era5_degC',\n",
        "    'tmin_era5_degC'\n",
        "]\n",
        "sum_data_band_names = [\n",
        "    'et_gldas_mm',\n",
        "    'tws_gldas_mm',\n",
        "    'ppt_era5_mm',\n",
        "    'runoff_era5_mm',\n",
        "]\n",
        "df_list = []\n",
        "\n",
        "for gee_date in date_list:\n",
        "    year, month, day = gee_date.split('-')\n",
        "    max_day = calendar.monthrange(int(year), int(month))[1]\n",
        "    if int(day) + 1 > max_day:\n",
        "      gee_date_adv = f'{year}-{int(month) + 1}-01'\n",
        "    else:\n",
        "      gee_date_adv = f'{year}-{month}-{int(day)+1}'\n",
        "    rzsm_gldas = gldas_ic.filterDate(gee_date, gee_date_adv) \\\n",
        "      .select('SoilMoist_RZ_tavg') \\\n",
        "      .mean() \\\n",
        "      .rename('rzsm_gldas_mm')\n",
        "    ssm_gldas = gldas_ic.filterDate(gee_date, gee_date_adv) \\\n",
        "      .select('SoilMoist_S_tavg') \\\n",
        "      .mean() \\\n",
        "      .rename('ssm_gldas_mm')\n",
        "    et_gldas = gldas_ic.filterDate(gee_date, gee_date_adv) \\\n",
        "      .select('Evap_tavg') \\\n",
        "      .mean() \\\n",
        "      .rename('et_gldas_mm')\n",
        "    tws_gldas = gldas_ic.filterDate(gee_date, gee_date_adv) \\\n",
        "      .select('TWS_tavg') \\\n",
        "      .mean() \\\n",
        "      .rename('tws_gldas_mm')\n",
        "    ppt_era5 = era5land_ic.filterDate(gee_date, gee_date_adv) \\\n",
        "      .select('total_precipitation_sum') \\\n",
        "      .mean() \\\n",
        "      .multiply(1000) \\\n",
        "      .rename('ppt_era5_mm')\n",
        "    runoff_era5 = era5land_ic.filterDate(gee_date, gee_date_adv) \\\n",
        "      .select('surface_runoff_sum') \\\n",
        "      .mean() \\\n",
        "      .multiply(1000) \\\n",
        "      .rename('runoff_era5_mm')\n",
        "    tmax_era5 = era5land_ic.filterDate(gee_date, gee_date_adv) \\\n",
        "      .select('temperature_2m_max') \\\n",
        "      .mean() \\\n",
        "      .add(-273.15) \\\n",
        "      .rename('tmax_era5_degC')\n",
        "    tmin_era5 = era5land_ic.filterDate(gee_date, gee_date_adv) \\\n",
        "      .select('temperature_2m_min') \\\n",
        "      .mean() \\\n",
        "      .add(-273.15) \\\n",
        "      .rename('tmin_era5_degC')\n",
        "    data_bands = [\n",
        "        rzsm_gldas,\n",
        "        ssm_gldas,\n",
        "        et_gldas,\n",
        "        tws_gldas,\n",
        "        ppt_era5,\n",
        "        runoff_era5,\n",
        "        tmax_era5,\n",
        "        tmin_era5\n",
        "    ]\n",
        "    sum_data_bands = [\n",
        "        et_gldas,\n",
        "        tws_gldas,\n",
        "        ppt_era5,\n",
        "        runoff_era5,\n",
        "    ]\n",
        "    data_img = rzsm_gldas\n",
        "    for band in data_bands:\n",
        "        data_img = data_img.addBands(band)\n",
        "    data_img_sum = et_gldas\n",
        "    for band in sum_data_bands:\n",
        "        data_img_sum = data_img_sum.addBands(band)\n",
        "    # Filter Over Feature Collection\n",
        "    data_fc_mean = data_img.reduceRegions(\n",
        "        collection=fc,\n",
        "        reducer=ee.Reducer.mean(),\n",
        "        scale=11000,\n",
        "        tileScale=1\n",
        "    )\n",
        "    data_fc_sum = data_img_sum.reduceRegions(\n",
        "        collection=fc,\n",
        "        reducer=ee.Reducer.sum(),\n",
        "        scale=11000,\n",
        "        tileScale=1\n",
        "    )\n",
        "\n",
        "    # Download table\n",
        "    url = data_fc_mean.getDownloadURL('csv', data_band_names)\n",
        "    df = pd.read_csv(url)\n",
        "    df.columns = [col.replace('mm', 'mean_mm') for col in df.columns]\n",
        "    url = data_fc_sum.getDownloadURL('csv', sum_data_band_names)\n",
        "    df_sum = pd.read_csv(url)\n",
        "    df_sum.columns = [col.replace('mm', 'sum_mm') for col in df_sum.columns]\n",
        "    df = pd.concat([df, df_sum], axis=1)\n",
        "    df['Date'] = pd.to_datetime(gee_date)\n",
        "    df.to_csv(f'{temp_dir}Daily_GEE_{gee_date}.csv', index=False)\n",
        "    # Append to df\n",
        "    df_list.append(df)\n",
        "daily_gee_df = pd.concat(df_list).sort_values(by='Date')\n",
        "daily_gee_df.to_csv(f'{workplace_dir}daily_gee_data.csv', index=False)\n",
        "df_list = []\n",
        "for month_yr in month_yr_list:\n",
        "    year, month = month_yr.split('-')\n",
        "    if int(month) + 1 > 12:\n",
        "      month_year_adv = f'{int(year) + 1}-01'\n",
        "    else:\n",
        "      month_year_adv = f'{year}-{int(month) + 1}'\n",
        "    try:\n",
        "        lwe_grace = grace_ic.filterDate(month_yr, month_year_adv) \\\n",
        "          .select('lwe_thickness') \\\n",
        "          .first() \\\n",
        "          .multiply(100) \\\n",
        "          .rename('lwe_thickness_mm')\n",
        "\n",
        "        data_fc_mean = lwe_grace.reduceRegions(\n",
        "            collection=fc,\n",
        "            reducer=ee.Reducer.mean(),\n",
        "            scale=55660,\n",
        "            tileScale=1\n",
        "        )\n",
        "        data_fc_sum = lwe_grace.reduceRegions(\n",
        "            collection=fc,\n",
        "            reducer=ee.Reducer.sum(),\n",
        "            scale=55660,\n",
        "            tileScale=1\n",
        "        )\n",
        "        url = data_fc_mean.getDownloadURL('csv', ['mean'])\n",
        "        df = pd.read_csv(url)\n",
        "        df.columns = ['lwe_thickness_mean_mm']\n",
        "        url = data_fc_sum.getDownloadURL('csv', ['sum'])\n",
        "        df_sum = pd.read_csv(url)\n",
        "        df_sum.columns = ['lwe_thickness_sum_mm']\n",
        "        df = pd.concat([df, df_sum], axis=1)\n",
        "        df['Date'] = pd.to_datetime(f'{month_yr}-01')\n",
        "        df.to_csv(f'{temp_dir}Monthly_GRACE_{month_yr}.csv', index=False)\n",
        "        df_list.append(df)\n",
        "    except ee.EEException:\n",
        "        print(f\"No data for {month_yr}\")\n",
        "        continue\n",
        "monthyl_grace_df = pd.concat(df_list).sort_values(by='Date')\n",
        "monthyl_grace_df.to_csv(f'{workplace_dir}monthly_grace_data.csv', index=False)\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n"
      ]
    },
    {
