      "source": [
        "# First, mount your Google Drive\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# Navigate to the folder where your shapefile is located\n",
        "# Replace 'My Drive/Shapefiles' with the actual path to your shapefile folder\n",
        "workplace_dir = '/content/drive/My Drive/GRACE-GRB/'\n",
        "shapefile_dir = f'{workplace_dir}Ganga Basin Shapefile/'\n",
        "\n",
        "# List the files in the folder to check if the shapefile is there\n",
        "!ls \"{shapefile_dir}\"\n",
        "\n",
        "# Assuming your shapefile is named 'ganga_basin.shp'\n",
        "# You'll need to install a library to read shapefiles, like geopandas\n",
        "!pip install geopandas\n",
        "\n",
        "import geopandas as gpd\n",
        "\n",
        "# Construct the full path to your shapefile\n",
        "shapefile_path = f\"{shapefile_dir}/Ganga_basin.shp\"\n",
        "\n",
        "# Read the shapefile into a GeoDataFrame\n",
        "try:\n",
        "    ganga_basin_gdf = gpd.read_file(shapefile_path)\n",
        "    print(\"Shapefile loaded successfully.\")\n",
        "    print(ganga_basin_gdf.head())\n",
        "except Exception as e:\n",
        "    print(f\"Error loading shapefile: {e}\")\n",
        "    print(\"Please ensure the shapefile path is correct and all associated files (.shx, .dbf, .prj, etc.) are in the same folder.\")"
      ]
    },
