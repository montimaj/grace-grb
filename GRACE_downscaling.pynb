      ],
      "source": [
        "# plot shapefile\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Assuming ganga_basin_gdf is your GeoDataFrame\n",
        "plt.figure(figsize=(10, 10))\n",
        "ganga_basin_gdf.plot(ax=plt.gca(), color='blue', edgecolor='black', linewidth=1)\n",
        "plt.title('Ganga Basin')\n",
        "plt.xlabel('Longitude ($^\\circ$)')\n",
        "plt.ylabel('Latitude ($^\\circ$)')\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
    },
